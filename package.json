    "test:quality": "npm run quality:gate",
    "predev": "npm run check:runtime && node scripts/prepare-premium-preview.mjs",
    "dev": "vite",
    "prebuild": "npm run check:runtime && node scripts/prepare-premium-preview.mjs",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
