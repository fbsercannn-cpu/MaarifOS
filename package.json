    "test:typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-policy.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=65 --test-coverage-functions=85 --test tests/features/*.test.mjs",
