    "tymm:review-package": "node scripts/tymm-human-review-package.mjs",
    "test:runtime:ui:official-forms": "node scripts/run-runtime-tests.mjs --budget-ms=120000 tests/official-forms-mobile.spec.ts --workers=1",
    "test:runtime:ui:cloud-account": "node scripts/run-runtime-tests.mjs --budget-ms=120000 tests/core/cloud-session.spec.ts tests/core/cloud-sync.spec.ts tests/cloud-account-ui.spec.ts --workers=1",
    "test:runtime:ui:assistant-tools": "node scripts/run-runtime-tests.mjs --budget-ms=60000 tests/assistant-tools-ui.spec.ts --workers=1",
    "test:runtime:ui:device-transfer": "node scripts/run-runtime-tests.mjs --budget-ms=60000 tests/device-transfer-guide.spec.ts --workers=1",
    "test:native": "node --test tests/native/*.test.mjs",
    "native:sync": "npm run build && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios"
