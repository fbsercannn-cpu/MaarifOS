{
  "name": "app",
  "private": true,
  "version": "0.75.4",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <27"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
