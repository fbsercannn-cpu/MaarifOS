{
  "name": "app",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:auth": "node --test tests/auth/*.test.mjs",
    "test:migration": "node --test tests/features/*.test.mjs",
    "test:data": "node scripts/run-runtime-tests.mjs tests/core/backup.spec.ts",
    "test:runtime": "node scripts/run-runtime-tests.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:pwa": "node --test tests/pwa-contract.test.mjs",
    "test:pwa:production": "node scripts/run-pwa-tests.mjs",
    "test:quality": "npm run check:runtime && npm run test:auth && npm run test:migration && npm run test:runtime && npm run test:pwa && npm run build && npm run test:sites && npm run test:pwa:production",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "postcss": "8.5.24",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
